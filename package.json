{
  "name": "qualidoc-v3",
  "version": "3.0.0",
  "description": "Qualidoc V3 — Génération automatisée de procédures techniques UNITEP/EDF assistée par IA Mistral (vision + scraping constructeur)",
  "main": "src/main/main.js",
  "type": "module",
  "author": "UNITEP",
  "scripts": {
    "predev": "node scripts/free-port.js 5173",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build && electron-builder",
    "build:vite": "vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "docx": "^8.5.0",
    "electron-store": "^8.2.0",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "uuid": "^10.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "puppeteer": "^23.6.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "fr.unitep.qualidoc-v3",
    "productName": "Qualidoc V3",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "icone/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icone/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
